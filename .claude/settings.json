{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-memory-updated.sh",
            "timeout": 15,
            "statusMessage": "Checking project memory was updated"
          }
        ]
      }
    ]
  }
}
